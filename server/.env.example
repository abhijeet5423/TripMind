# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Option A: Local MongoDB (for development with MongoDB Compass / Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017/tripmind
# Option B: MongoDB Atlas (cloud cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripmind?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Client Application URL (for CORS policy)
CLIENT_URL=http://localhost:5173

# Google Gemini AI Configuration (Free Tier - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Reverse Proxy Trust (Render standard: 1 hop)
TRUST_PROXY=1

# Email / SMTP Delivery Configuration (Day 54)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="TripMind <no-reply@tripmind.com>"

# API Rate Limiting Configuration (Optional - Defaults shown)
# API_RATE_LIMIT_WINDOW_MS=900000
# API_RATE_LIMIT_MAX=120
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
# FORGOT_PASSWORD_RATE_LIMIT_MAX=5
# RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
# RESET_PASSWORD_RATE_LIMIT_MAX=10
# RESEND_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
# RESEND_VERIFICATION_RATE_LIMIT_MAX=3
# VERIFY_EMAIL_RATE_LIMIT_WINDOW_MS=900000
# VERIFY_EMAIL_RATE_LIMIT_MAX=15
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX=15
# SHARE_RATE_LIMIT_WINDOW_MS=60000
# SHARE_RATE_LIMIT_MAX=60

# Temporary Protected SMTP Diagnostic (Render Free Plan - Disabled by default)
# Generate a token e.g. via: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Note: crypto.randomBytes(24).toString('hex') generates 48 hexadecimal characters (192 bits of entropy).
# SMTP_DIAGNOSTIC_ENABLED=false
# SMTP_DIAGNOSTIC_TOKEN=your_secure_random_48char_diagnostic_token_here

