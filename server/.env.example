# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Option A: Local MongoDB (for development with MongoDB Compass / Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017/tripmind
# Option B: MongoDB Atlas (cloud cluster)
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tripmind?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Client Application URL (for CORS policy)
CLIENT_URL=http://localhost:5173

# Google Gemini AI Configuration (Free Tier - Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

